# Required. Use a unique shared access password and a random secret of at least 32 characters.
APP_PASSWORD=
SESSION_SECRET=

# Keep this database file on the hosting provider's persistent disk.
DATABASE_PATH=./data/products.sqlite3

# Required when the site is served over HTTPS (the production default).
COOKIE_SECURE=true

# Optional integrations. Product entry, management, and Excel export work without these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
